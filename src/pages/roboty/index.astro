---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const works = (await getCollection('roboty')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Роботи — концепції редизайну та сайти з нуля | YonkaAgency"
  description="Роботи Остапа Йонки, Львів: концепції редизайну реальних сайтів і сайти з нуля. Кожна зі справжніми замірами й переліком того, що лишилось невирішеним."
  path="/roboty/"
>
  <section class="mx-auto max-w-[80rem] px-5 sm:px-8 pt-12 sm:pt-20">
    <h1 class="max-w-[18ch] text-[clamp(2.2rem,6vw,4rem)] font-semibold leading-[0.98] tracking-[-0.04em]">
      Роботи
    </h1>
    <p class="mt-6 max-w-[56ch] text-[1.0625rem] sm:text-[1.125rem] leading-[1.5] text-ink-soft">
      Тут поки немає зданих замовлень: є концепції редизайну чужих сайтів і робота,
      віддана замовнику на погодження. Кожна містить <span class="text-ink">справжні
      заміри</span> — контраст, вагу, швидкість, розміри елементів керування — і перелік
      того, що в ній лишилось невирішеним.
    </p>

    {works.length === 0 ? (
      <p class="notation mt-12">Перші концепти в роботі</p>
    ) : (
      <ol class="relative mt-14 pl-9 sm:pl-12">
        <span class="absolute left-[7px] top-5 bottom-8 w-[3px] rounded-full bg-route/25 sm:left-[11px]" aria-hidden="true"></span>
        {works.map((w) => (
          <li class="relative pb-14 last:pb-0">
            <span class="absolute -left-9 top-[10px] h-[17px] w-[17px] rounded-full border-[3px] border-route bg-paper sm:-left-12" aria-hidden="true"></span>
            <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/roboty/${w.id}/`} class="group block">
              <p class="notation">
                {w.data.status === 'concept' ? 'Концепт редизайну' : w.data.status === 'draft' ? 'Чернетка для замовника' : w.data.kind} · {w.data.niche}
              </p>
              <h2 class="mt-2 max-w-[24ch] text-[clamp(1.375rem,3vw,2.125rem)] font-semibold leading-[1.08] tracking-[-0.03em] group-hover:text-route">
                {w.data.title}
              </h2>
              <p class="mt-3 max-w-[54ch] text-[0.9375rem] leading-[1.6] text-ink-soft">{w.data.summary}</p>
              <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                {w.data.metrics.slice(0, 3).map((m) => (
                  <span class="notation">
                    {m.label}: {m.before && <span class="text-detour-ink">{m.before}</span>}
                    <span class="text-route">{m.before ? ' → ' : ' '}{m.after}</span>
                  </span>
                ))}
              </p>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="mx-auto max-w-[80rem] px-5 sm:px-8 mt-20 sm:mt-28">
    <div class="border-t-[3px] border-route pt-9 sm:max-w-[46rem]">
      <h2 class="max-w-[22ch] text-[clamp(1.6rem,3.4vw,2.5rem)] font-semibold leading-[1.04] tracking-[-0.035em]">
        Зробити такий розбір вашого сайту
      </h2>
      <p class="mt-5 max-w-[50ch] text-ink-soft">
        Надішліть посилання — покажу заміри чинного сайту й що з ними не так.
        Безкоштовно, без зобов'язань.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://t.me/YonkaAgency"
           class="inline-flex min-h-[52px] items-center rounded-[3px] bg-route px-6 text-[1.0625rem] font-medium text-paper transition-colors hover:bg-route-bright">
          Написати в Telegram
        </a>
        <a href="tel:+380962192952"
           class="inline-flex min-h-[52px] items-center rounded-[3px] border border-ink/25 px-6 text-[1.0625rem] font-medium transition-colors hover:border-ink hover:bg-paper-deep">
          +380 96 219 29 52
        </a>
      </div>
    </div>
  </section>
</Base>
